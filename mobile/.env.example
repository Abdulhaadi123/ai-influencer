# ═════════════════════════════════════════════════════════════════════════════
# Mobile app configuration
# ═════════════════════════════════════════════════════════════════════════════
#
# Copy to `mobile/.env` and fill in. Restart the dev server after any change —
# EXPO_PUBLIC_* values are inlined at BUILD time, not read at runtime.
#
# ── The rule for this file ───────────────────────────────────────────────────
#
# Everything here ships inside the .apk/.ipa and can be extracted by anyone who
# installs the app. Only values that are safe to publish belong here.
#
# That is why there is no KIE key and no OpenAI key any more. Both used to live
# here and both were extractable; they now sit on the server behind /api, which
# authenticates every request. If you find yourself adding a secret to this
# file, it belongs in the server environment instead.


# ── Supabase ─────────────────────────────────────────────────────────────────
#
# Dashboard → Project Settings → API.
#
# The anon key is PUBLIC by design. It only identifies the project; every table
# is protected by Row Level Security, so the key on its own grants nothing.
# Supabase publishes it deliberately.
#
# The service_role key must NEVER appear here — it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# ── Backend ──────────────────────────────────────────────────────────────────
#
# Absolute URL of the deployed API. React Native has no origin to resolve a
# relative path against, so without this every /api call fails.
#
# Local development against a machine on the same network needs the LAN IP, not
# localhost — localhost on the phone means the phone.

EXPO_PUBLIC_API_BASE=https://your-app.vercel.app


# ── Password reset ───────────────────────────────────────────────────────────
#
# Where the reset email sends the user. The app registers the `aiinfluencer`
# scheme (see app.json), and this exact URL must be added to
# Supabase → Authentication → URL Configuration → Redirect URLs, or the link
# will be rejected.

EXPO_PUBLIC_PASSWORD_RESET_REDIRECT=aiinfluencer://reset-password


# ── Email confirmation ───────────────────────────────────────────────────────
#
# Where the sign-up confirmation email lands the user. Add this exact URL to
# Supabase → Authentication → URL Configuration → Redirect URLs as well. The app
# falls back to this value if it is missing.

EXPO_PUBLIC_EMAIL_CONFIRM_REDIRECT=aiinfluencer://confirm-email
