# ═════════════════════════════════════════════════════════════════════════════
# Mobile app configuration
# ═════════════════════════════════════════════════════════════════════════════
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so
# everything in this file ships inside the .apk and can be read by anyone who
# unpacks it. Only public values may live here — the app needs one, plus RevenueCat's two public keys.
#
# The app has no database address, no storage keys and no API keys. It reaches
# all of those through the backend, which checks who is asking.
#
# After editing, restart Metro with `npx expo start -c` — the value is inlined
# at bundle time. EAS cloud builds do not upload this file (it is gitignored):
# set the same variable in the EAS environment for each build profile.


# ── Our API ──────────────────────────────────────────────────────────────────
#
# Absolute URL, no trailing slash.
#
#   Android emulator, backend on this computer : http://10.0.2.2:8080
#   Phone on the same Wi-Fi                    : http://<this computer's LAN IP>:8080
#   Production                                 : https://api.your-domain.com

EXPO_PUBLIC_API_BASE=https://api.your-domain.com


# ── Continue with Google ─────────────────────────────────────────────────────
#
# The Web application client's ID from Google Cloud (not an Android client's, not a Desktop one).
# Public: it ships in the app. Never put the client secret anywhere; nothing here uses it.
# The server needs the same ID in GOOGLE_CLIENT_IDS. Empty: the button is not shown.
# Real builds set it in eas.json; this is for running locally.

# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=


# ── RevenueCat (credit packs) ────────────────────────────────────────────────
#
# Public SDK keys from the RevenueCat dashboard (API keys). Not secrets: they ship
# in the app. The SECRET key and the webhook secret belong on the server only.

# Google Play key (goog_...). Used by real builds.
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Test Store key (test_...). Development builds only — the SDK crashes on purpose if
# a release build is given it. Purchases made with it are simulated: no store, no money.
# EXPO_PUBLIC_REVENUECAT_TEST_KEY=
