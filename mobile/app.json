{
  "expo": {
    "name": "AI Influencer",
    "slug": "ai-influencer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "aiinfluencer",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiinfluencer.app"
    },
    "android": {
      "package": "com.aiinfluencer.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-video",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "$(PRODUCT_NAME) needs access to your photos so you can use them as reference images and motion videos.",
          "cameraPermission": "$(PRODUCT_NAME) needs the camera so you can take a reference photo.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "11ec93f7-05e5-4055-b322-4d8c73d0f0ff"
      }
    },
    "owner": "hadi1234554321"
  }
}
