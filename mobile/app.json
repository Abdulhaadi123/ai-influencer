{
  "expo": {
    "name": "InfluenzaAi",
    "slug": "ai-influencer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "aiinfluencer",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiinfluencer.app"
    },
    "android": {
      "package": "com.aiinfluencer.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withOptionalCamera",
      "expo-sharing",
      "expo-video",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "$(PRODUCT_NAME) needs access to your photos so you can use them as reference images and motion videos.",
          "cameraPermission": "$(PRODUCT_NAME) needs the camera so you can take a reference photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-image"
    ],
    "owner": "nnkjk",
    "extra": {
      "eas": {
        "projectId": "ebb9f629-0dd9-42ff-91af-df05e0dfff58"
      }
    }
  }
}
