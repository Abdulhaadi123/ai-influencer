# ═════════════════════════════════════════════════════════════════════════════
# Server configuration — the /api functions
# ═════════════════════════════════════════════════════════════════════════════
#
# Copy to `.env` for local development, and set the same values in the Vercel
# project (Settings → Environment Variables) for deployment.
#
# ── The rule for this file ───────────────────────────────────────────────────
#
# These are real secrets. Nothing here is prefixed EXPO_PUBLIC_ or VITE_,
# because either prefix would ship the value to a client bundle. If you ever
# need one of these values on a device, the answer is a new /api endpoint, not
# a prefix.
#
# `.env` is gitignored. Keep it that way.


# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co

# Public — safe in a client bundle. Used by the web build.
SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses Row Level Security completely: it can read and write every
# user's rows. Used only to verify JWTs and to do work the user cannot do for
# themselves (checking ownership before signing an S3 URL, sweeping objects
# after a delete). Never send it to a client, never log it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ── AWS S3 ───────────────────────────────────────────────────────────────────
#
# The bucket holds every user-uploaded and generated file. It must be PRIVATE:
# Block Public Access on, no public bucket policy. Files are served only
# through presigned URLs minted after an ownership check.

S3_BUCKET=your-bucket-name
AWS_REGION=eu-west-1

# Credentials for an IAM user scoped to this bucket only — s3:PutObject,
# s3:GetObject, s3:DeleteObject, s3:ListBucket. Do not use a root key.
# Omit both to fall back to an instance role where one is available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Per-account storage cap, enforced before an upload URL is minted.
# Default 5 GB.
USER_STORAGE_QUOTA_BYTES=5368709120


# ── Generation ───────────────────────────────────────────────────────────────
#
# The KIE key. This used to be compiled into the mobile app, where anyone who
# unpacked the .apk could extract it and spend the account's credits. It lives
# here now, behind /api/kie, which requires a valid session.

KIE_API_KEY=your-kie-key

# Whether the generation-engine check returns the account's credit balance to
# the app. Leave false in production: every signed-in user could read it.
EXPOSE_CREDIT_BALANCE=false

# Optional. Powers the live prompt suggestions; leave empty and the feature
# simply never appears. Set a spending limit on the key.
OPENAI_API_KEY=
PROMPT_ASSIST_MODEL=gpt-4o-mini


# ── CORS and cookies ─────────────────────────────────────────────────────────
#
# Comma-separated website origins allowed to call the API from a browser.
# Empty means no website may — which is correct for the mobile app, since a
# native app sends no Origin and is not subject to CORS at all.
ALLOWED_ORIGINS=

# 'Lax' when the app and API share an origin, which is the normal deployment.
# 'None' for a split origin — and then the cookie is also forced Secure.
SESSION_COOKIE_SAMESITE=Lax


# ── Web only ─────────────────────────────────────────────────────────────────
# Where a password-reset email sends a browser user.
PASSWORD_RESET_REDIRECT=https://your-app.vercel.app


# ── Self-hosted only (server/ + docker-compose) ──────────────────────────────
# Ignored on Vercel, which has no long-running process.

# Port the Express server listens on. Caddy proxies to it.
PORT=8080

# How often the worker sweeps for finished jobs. Lower is more responsive and
# more requests against KIE's rate limit; 15s is a reasonable balance.
WORKER_CYCLE_MS=15000
