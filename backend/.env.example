# ═════════════════════════════════════════════════════════════════════════════
# Server configuration
# ═════════════════════════════════════════════════════════════════════════════
#
# Copy to `.env` next to docker-compose.yml and fill it in. Every value here is
# a secret or a server-only setting: none of them ever goes into the app. `.env`
# is gitignored — keep it that way.


# ── Database ─────────────────────────────────────────────────────────────────
#
# The password for the Postgres container. Letters and digits only (it goes
# into a connection URL). Generate one with:  openssl rand -hex 32
POSTGRES_PASSWORD=

# docker-compose builds DATABASE_URL from the password above. Set it yourself
# only when running outside Docker — local development, or AWS RDS:
# DATABASE_URL=postgres://app:PASSWORD@localhost:5432/app


# ── Public address ───────────────────────────────────────────────────────────
#
# Where this server is reached from the internet. Links in emails point here.
PUBLIC_BASE_URL=https://api.your-domain.com

APP_NAME=AI Influencer
# Opens the app from the "Open the app" button on the email-link pages.
APP_OPEN_URL=aiinfluencer://


# ── Accounts ─────────────────────────────────────────────────────────────────
#
# true: new accounts must confirm their email before they can sign in.
REQUIRE_EMAIL_CONFIRMATION=true

# Sign in with Google. The Web client ID(s) from Google Cloud Console (APIs & Services → Credentials,
# type "Web application", ending in .apps.googleusercontent.com); several, comma-separated, are allowed.
# A Google ID token is accepted only if it was made for one of these. The same ID goes into the app
# (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID). It is not a secret, and there is no client secret to set.
# Empty: "Continue with Google" answers "not available" and email sign-in works as before.
GOOGLE_CLIENT_IDS=


# ── Email — SMTP ─────────────────────────────────────────────────────────────
#
# Any mailbox that speaks SMTP. Without these, production cannot send
# verification or password-reset emails.
#
#   Gmail            smtp.gmail.com : 465     user = the full address,
#                                             pass = an APP PASSWORD, not the
#                                             account password (needs 2-step
#                                             verification turned on first:
#                                             myaccount.google.com/apppasswords)
#   Most hosts       mail.your-host.com : 465 or 587
#
# Port 465 uses TLS immediately; 587 upgrades with STARTTLS. SMTP_SECURE is
# derived from the port and only needs setting for an unusual server.
#
# EMAIL_FROM defaults to SMTP_USER. Gmail requires the From address to be the
# mailbox that signed in, so leave it unset there.
#
# EMAIL_TRANSPORT=log writes each email to the server log instead of sending it
# — for trying a new server out before its mailbox is ready. Read the link with
# `docker compose logs api`. Remove it before real users sign up.
EMAIL_TRANSPORT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true
EMAIL_FROM=
EMAIL_FROM_NAME=AI Influencer


# ── AWS S3 ───────────────────────────────────────────────────────────────────
#
# The bucket must be PRIVATE (Block Public Access on). Files are served only as
# presigned URLs after an ownership check. The daily database backups also go
# here, under backups/.
S3_BUCKET=
AWS_REGION=us-east-2

# An IAM user scoped to this bucket: s3:PutObject, s3:GetObject,
# s3:DeleteObject, s3:ListBucket. Never a root key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Per-account storage cap. Default 5 GB.
USER_STORAGE_QUOTA_BYTES=5368709120

# Other per-account ceilings. Leave unset for the defaults, which an ordinary
# person never meets: 100 influencers, and 150 calls in ten seconds / 600 in a
# minute across every signed-in route.
# MAX_INFLUENCERS_PER_USER=100
# USER_REQUESTS_PER_10S=150
# USER_REQUESTS_PER_MINUTE=600


# ── Generation ───────────────────────────────────────────────────────────────

KIE_API_KEY=

# Lets KIE tell this server the moment a generation finishes, instead of the
# worker finding out on its next sweep. Generate the "Webhook HMAC key" at
# https://kie.ai/settings and paste it here; PUBLIC_BASE_URL must be set too.
#
# Empty = callbacks are neither asked for nor accepted, and the worker collects
# results as before. An unsigned callback is always refused: without the key,
# anyone could claim a job had finished and hand us a file.
KIE_WEBHOOK_SECRET=

# Whether the engine check returns the account's credit balance to the app.
# Leave false in production: every signed-in user could read it.
EXPOSE_CREDIT_BALANCE=false

# Powers prompt suggestions AND content moderation (OpenAI's moderation endpoint,
# which is free). With this empty, suggestions are hidden and NOTHING IS CHECKED —
# the server says so when it starts. Set it before real users arrive.
OPENAI_API_KEY=
PROMPT_ASSIST_MODEL=gpt-4o-mini


# ── Content moderation ───────────────────────────────────────────────────────
#
# Every generation request, uploaded file and generated result is checked
# (README: "Content moderation"). All of these have working defaults; change one
# only for a reason.

# true | false. Unset means "on when OPENAI_API_KEY is set".
# MODERATION_ENABLED=

# What happens to a request when the checker cannot be reached.
#   closed (default)  refuse it — "try again in a moment"
#   open              let it through unchecked
# MODERATION_FAIL_MODE=closed

# KIE's own filter (`nsfw_checker`) for the models that have one. Independent of
# the OpenAI check, and free. Leave on.
# KIE_NSFW_CHECKER=true

# Overrides for the thresholds in api/_lib/moderation/policy.js, as JSON. Watch the
# admin panel's moderation queue for a week, then tune. "null" removes a level,
# "false" ignores a category. The minors rule cannot be loosened past 0.5.
#   MODERATION_THRESHOLDS={"sexual":{"block":0.9},"violence":{"review":null}}
# MODERATION_THRESHOLDS=

# Refusals (counted once per minute) within the window that suspend an account,
# and whether anything involving a minor suspends it at once.
# MODERATION_STRIKE_LIMIT=5
# MODERATION_STRIKE_WINDOW_DAYS=30
# MODERATION_SUSPEND_ON_MINORS=true

# Frames sampled from a video to check it (1-8), and where ffmpeg is if it is not
# on PATH. The Docker image installs ffmpeg, so these are for running outside it.
# MODERATION_VIDEO_FRAMES=4
# FFMPEG_PATH=
# FFPROBE_PATH=


# ── Admin panel ──────────────────────────────────────────────────────────────
#
# Comma-separated emails to make administrators when the server starts. The account
# must already exist with a CONFIRMED email, and this is ignored while
# REQUIRE_EMAIL_CONFIRMATION=false (see README: "Admin panel"). Then sign in at
# https://<your domain>/admin.
ADMIN_EMAILS=

# Where the admin panel's files are. Default: the repository's admin-panel/ folder next to
# backend/ (in Docker it is mounted at /admin-panel — see docker-compose.yml). Leave unset.
# ADMIN_UI_DIR=


# ── Web access (CORS) ────────────────────────────────────────────────────────
#
# Comma-separated website origins allowed to call the API from a browser. Empty
# allows none — correct for the mobile app, which is not subject to CORS.
ALLOWED_ORIGINS=


# ── Processes ────────────────────────────────────────────────────────────────

PORT=8080
WORKER_CYCLE_MS=15000
BACKUP_INTERVAL_SECONDS=86400


# ── Credits (packs bought through RevenueCat) ────────────────────────────────
#
# README: "Credits". With BILLING_ENFORCED unset the server only WATCHES: nothing is
# taken and nobody is stopped, and its log says who it would have refused.

# Exactly "true" charges for generations and refuses requests without enough credits.
# BILLING_ENFORCED=

# The Authorization value you typed into RevenueCat's webhook settings
# (https://<your-api>/webhooks/revenuecat). Use a long random string. Keep it in the
# server's secret store, not in git. Empty = the webhook refuses every delivery.
REVENUECAT_WEBHOOK_AUTH=

# Credit purchases RevenueCat marks SANDBOX (test purchases). true is right while
# testing; set false when real sales start.
# REVENUECAT_ACCEPT_SANDBOX=true
