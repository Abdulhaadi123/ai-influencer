{
  "name": "ai-influencer-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API, generation worker and database for AI Influencer Studio. Deployable on its own — no app or web code required.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "worker": "node server/worker.js",
    "dev": "node --watch server/index.js",
    "migrate": "node db/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@node-rs/argon2": "^2.2.1",
    "express": "^5.1.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "happy-dom": "^20.14.6"
  }
}
